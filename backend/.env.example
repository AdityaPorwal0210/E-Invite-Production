# ---------------------------------------------------------------------------
# Backend environment template.
# Copy this file to `.env` and fill in REAL values. Never commit `.env`.
# Do NOT put real secrets in this file — it is committed to git.
# ---------------------------------------------------------------------------

PORT=5000

# MongoDB Atlas connection string (mongodb+srv://user:password@cluster.../dbname)
MONGO_URI=your_mongodb_connection_string_here

# Secret used to sign JWT auth tokens. Use a long random string.
JWT_SECRET=your_jwt_secret_here

# Cloudinary (image/attachment uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Legacy SMTP (Gmail) — kept for reference; transactional email now goes via Brevo
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# Brevo (transactional email + OTPs)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=E-Invite

# Public URL of the web frontend (used in email links, deep links)
FRONTEND_URL=http://localhost:5173

# Google Sign-in — the Web OAuth client ID the backend verifies ID tokens against
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Razorpay (premium upgrade payments). Use rzp_test_... in development.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Paywall kill switch: "true" enforces the free guest limit, "false" disables it
PAYWALL_ACTIVE=false

# Environment mode
NODE_ENV=development

# Mobile app deep-link config (Expo dev server)
EXPO_DEV_IP=127.0.0.1
EXPO_PORT=8081
